{
    "name": "PL_ADF_Databricks",
    "properties": {
        "description": "End-to-end pipeline: Copy raw data from Blob Storage to ADLS Gen2, then trigger Databricks notebook for transformation.",
        "activities": [
            {
                "name": "CopyRawDataToADLS",
                "type": "Copy",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30
                },
                "typeProperties": {
                    "source": {
                        "type": "DelimitedTextSource",
                        "storeSettings": {
                            "type": "AzureBlobStorageReadSettings",
                            "recursive": false
                        },
                        "formatSettings": {
                            "type": "DelimitedTextReadSettings"
                        }
                    },
                    "sink": {
                        "type": "DelimitedTextSink",
                        "storeSettings": {
                            "type": "AzureBlobFSWriteSettings"
                        },
                        "formatSettings": {
                            "type": "DelimitedTextWriteSettings",
                            "quoteAllText": true,
                            "fileExtension": ".csv"
                        }
                    },
                    "enableStaging": false
                },
                "inputs": [
                    {
                        "referenceName": "DS_BlobSource_CSV",
                        "type": "DatasetReference",
                        "parameters": {
                            "fileName": "student_performance.csv"
                        }
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "DS_ADLS_Sink_CSV",
                        "type": "DatasetReference",
                        "parameters": {
                            "containerName": "rawdata",
                            "fileName": "student_performance.csv"
                        }
                    }
                ]
            },
            {
                "name": "RunTransformDataNotebook",
                "type": "DatabricksNotebook",
                "dependsOn": [
                    {
                        "activity": "CopyRawDataToADLS",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 60
                },
                "typeProperties": {
                    "notebookPath": "/Users/abhishek.25005296@jainuniversity.ac.in/TransformData",
                    "baseParameters": {
                        "input_path": "/mnt/rawdata/student_performance.csv",
                        "output_path": "/mnt/output/student_performance_cleaned"
                    }
                },
                "linkedServiceName": {
                    "referenceName": "LS_Databricks",
                    "type": "LinkedServiceReference"
                }
            }
        ],
        "annotations": [
            "Experiment06",
            "CloudAnalytics",
            "25MCAR0141"
        ],
        "folder": {
            "name": "CA_Lab_Pipelines"
        }
    }
}
